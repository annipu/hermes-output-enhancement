+    if (previous[id] === next[id]) continue
+    const target = id in next ? next[id] : pluginDefaults.get(id) ?? true
+    try {
+      await applyPluginEnabled(id, target)
+    } catch {
+      patchPlugin(id, { status: 'error', error: 'Could not restore plugin defaults after a preference reset.' })
