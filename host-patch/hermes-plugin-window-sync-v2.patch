+async function applyPeerDecisions(): Promise<void> {
+  // Read the latest stored snapshot instead of replaying a possibly stale event
+  // payload after a more recent local click. Never write it back: no echo loop.
+  const next = readStoredDecisions()
+  if (!next) return
+  const previous = $pluginDecisions.get()
+  $pluginDecisions.set(next)
+  for (const id of new Set([...Object.keys(previous), ...Object.keys(next)])) {
+    if (previous[id] === next[id]) continue
+    // A decision removed outside this window falls back to the plugin's default.
+    const target = id in next ? next[id] : pluginDefaults.get(id) ?? true
+    try {
+      await applyPluginEnabled(id, target)
+    } catch {
+      // A broken plugin must not block the remaining plugins or later events.
+      patchPlugin(id, { status: 'error', error: 'Could not apply a plugin preference from another window.' })
+    }
+  }
+}
