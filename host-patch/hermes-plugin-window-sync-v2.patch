+function onPeerPluginDecision(event: StorageEvent): void {
+  if (event.storageArea !== window.localStorage) return
+  // storage.clear() dispatches key === null; a removed key dispatches newValue === null.
+  const cleared = event.key === null
+  const removed = event.key === DECISIONS_KEY && event.newValue === null
+  if (cleared || removed) {
